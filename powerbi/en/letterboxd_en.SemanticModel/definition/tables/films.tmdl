table films
	lineageTag: 3563f7a1-ae4d-40d0-a88a-7792c1d2db01

	measure 'Average Rating' = AVERAGE(films[rating])
		formatString: 0.00
		lineageTag: 494bca5c-bc6c-45ab-ab71-3bcabb5c7cdb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Film Count' = COUNTROWS(films)
		formatString: 0
		lineageTag: 0b49e581-ee56-4a43-a9dd-9dab08f813f6

	measure 'Loved Share' = DIVIDE(CALCULATE(COUNTROWS(films), films[loved] = 1), COUNTROWS(films))
		formatString: 0%;-0%;0%
		lineageTag: d7ba8fa5-a137-49dd-81a1-43991c5fb05d

	measure 'Model Error (MAE)' = AVERAGE(films[abs_error])
		formatString: 0.00
		lineageTag: cb2376da-f754-41b2-bbbe-4827ca69e57f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Diff from Overall' = [Average Rating] - CALCULATE([Average Rating], ALL(films), ALL(film_genres), ALL(genres))
		lineageTag: fd995c3e-1b5b-4132-b7a9-386313a5f00e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TMDB Average' = AVERAGE(films[tmdb_rating])
		formatString: 0.00
		lineageTag: 4dd82790-5776-4f94-87f5-07d9f22da441

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Rating (15+ films)' = IF([Film Count] >= 15, [Average Rating])
		formatString: 0.00
		lineageTag: cf49e78f-5656-4045-97aa-d8b4b617353e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

